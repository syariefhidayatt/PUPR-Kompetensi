# --- Database (Neon) ---
# Runtime: koneksi POOLED (host berakhiran -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Migrasi: koneksi DIRECT (tanpa -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Aplikasi ---
NEXT_PUBLIC_APP_NAME="Sistem Kompetensi & Pelatihan"
# Salt ID publik (Sqids), min 16 karakter, rahasia. JANGAN diganti setelah produksi
# (semua token ID di URL akan berubah). Contoh: openssl rand -hex 16
ID_SALT=""

# --- Auth.js (WAJIB di Fase 1) ---
# Contoh: openssl rand -base64 32
AUTH_SECRET=""
# Opsional: tombol "Masuk dengan Google" hanya muncul bila keduanya terisi.
# Redirect URI di Google Cloud Console: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Rate limit (opsional; kosong = pembatas in-memory, hanya cocok untuk dev) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Fase berikutnya ---
CRON_SECRET=""

# --- Seed (dibaca prisma/seed.ts) ---
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""   # min 12 karakter
SEED_ADMIN_EMAIL=""
SEED_SAMPLE_DATA="false" # true = buat contoh instansi Pusat, Pemda, JF (HANYA untuk dev)
